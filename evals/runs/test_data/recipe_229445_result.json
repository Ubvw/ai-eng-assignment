  "recipe": {
    "recipe_id": "229445",
    "title": "Israeli Couscous and Cheese",
    "prep_time": "PT15M",
    "cook_time": "PT10M",
    "total_time": "PT25M",
    "servings": "4",
    "yield": "4",
    "ingredients": [
      {
        "id": "ingredient-0001",
        "text": "2 teaspoons butter",
        "name": "butter",
        "quantity": "2",
        "unit": "teaspoon"
      },
      {
        "id": "ingredient-0002",
        "text": "1 cup pearl (Israeli) couscous",
        "name": "pearl (Israeli) couscous",
        "quantity": "1",
        "unit": "cup"
      },
      {
        "id": "ingredient-0003",
        "text": "2 cups chicken broth",
        "name": "chicken broth",
        "quantity": "2",
        "unit": "cup"
      },
      {
        "id": "ingredient-0004",
        "text": "0.5 cup heavy cream",
        "name": "heavy cream",
        "quantity": "1/2",
        "unit": "cup"
      },
      {
        "id": "ingredient-0006",
        "text": "1 pinch cayenne pepper, or more to taste",
        "name": "cayenne pepper, or more to taste",
        "quantity": "1",
        "unit": "pinch"
      },
      {
        "id": "ingredient-0007",
        "text": "3 ounces shredded sharp Cheddar cheese",
        "name": "shredded sharp Cheddar cheese",
        "quantity": "3",
        "unit": "ounce"
      },
      {
        "id": "ingredient-0008",
        "text": "1 tablespoon chopped fresh chives",
        "name": "chopped fresh chives",
        "quantity": "1",
        "unit": "tablespoon"
      },
      {
        "id": "ingredient-0009",
        "text": "salt and freshly ground black pepper to taste",
        "name": "salt and freshly ground black pepper to taste",
        "quantity": null,
        "unit": null
      }
    ],
    "instructions": [
      {
        "id": "instruction-0001",
        "text": "Melt butter in a large skillet over medium heat. Add couscous; cook and stir until slightly toasted, 2 to 3 minutes."
      },
      {
        "id": "instruction-0002",
        "text": "Add chicken broth; bring to a boil. Reduce heat to low; simmer until most broth absorbed and couscous plumped, 6 to 7 minutes."
      },
      {
        "id": "instruction-0003",
        "text": "Stir in heavy cream; add cayenne pepper and cook until couscous tender, 2 to 3 minutes, adding more broth if needed."
      },
      {
        "id": "instruction-0004",
        "text": "Off heat, stir in Cheddar cheese until melted; add chives and stir to combine. Season with salt, black pepper, and cayenne pepper."
      }
    ]
  },
